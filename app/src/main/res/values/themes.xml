<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Minifadfed" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:forceDarkAllowed" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Minifadfed" parent="Base.Theme.Minifadfed" />

    <style name="Circular">
        <item name="cornerSize">50%</item>
    </style>


    <style name="TextMedium">
        <item name="fontFamily">@font/arabicui_text_medium</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextMessageSend">
        <item name="fontFamily">@font/arabicui_text_medium</item>
        <item name="android:textColor">@color/txt_message_send</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>